    "import tensorflow as tf\n",
    "from tensorflow.keras.layers import Embedding, Bidirectional, LSTM, Dense, Dropout, GlobalMaxPooling1D,SpatialDropout1D,BatchNormalization,Input\n",
    "from tensorflow.keras.models import Model\n",
    "from tensorflow.keras.optimizers import Adam\n",
    "from tensorflow.keras.callbacks import EarlyStopping, ModelCheckpoint\n",
    "\n",
    "embedding_dim = 128\n",
    "latent_dim = 256\n",
    "\n",
    "encoder_inputs = Input(shape=(max_len_eng,))\n",
    "encoder_embedding = Embedding(input_dim=len(eng_tokenizer.word_index) + 1, output_dim=embedding_dim, input_length=max_len_eng, mask_zero=True)(encoder_inputs)\n",
    "encoder_lstm = LSTM(latent_dim, return_state=True)\n",
    "_, state_h, state_c = encoder_lstm(encoder_embedding)\n",
    "encoder_staete = [state_h, state_c]\n",
    "\n",
    "\n",
    "decoder_input = Input(shape=(max_len_dec_in,))\n",
    "decoder_embedding = Embedding(input_dim=len(ger_tokenizer.word_index) + 1, output_dim=embedding_dim, input_length=max_len_dec_in, mask_zero=True)(decoder_input)\n",
    "decoder_lstm = LSTM(latent_dim, return_sequences=True, return_state=True)\n",
    "decoder_inputs, _, _ = decoder_lstm(decoder_embedding, initial_state=encoder_staete)\n",
    "decoder_dense = Dense(len(ger_tokenizer.word_index) + 1, activation='softmax')\n",
    "decoder_outputs = decoder_dense(decoder_inputs)\n",
    "model = Model([encoder_inputs, decoder_input], decoder_outputs)\n",
    "\n",
    "model.compile(\n",
    "    optimizer='adam',\n",
    "    loss='sparse_categorical_crossentropy',\n",
    "    metrics=['accuracy']\n",
    ")\n",
    "model.summary()"
   ]
