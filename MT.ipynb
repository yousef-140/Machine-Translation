    "#translate with beam search\n",
    "\n",
    "def translate_beam(sentence, beam_width):\n",
    "    seq = eng_tokenizer.texts_to_sequences([sentence.lower()])\n",
    "    seq = pad_sequences(seq, maxlen=max_len_eng, padding='post')\n",
    "    enc_out, h ,c = encoder_model.predict(seq, verbose=0)\n",
    "    beams = [([ger_tokenizer.word_index['start']], 0.0, h, c)]\n",
    "\n",
    "    for _ in range(max_len_dec_out):\n",
    "        new_beams = []\n",
    "\n",
    "        for tokens , score,h, c in beams:\n",
    "            if tokens[-1] == ger_tokenizer.word_index['end']:\n",
    "                new_beams.append((tokens, score, h, c))\n",
    "                continue\n",
    "\n",
    "            terget_seq = np.array([[tokens[-1]]])\n",
    "            output, h, c = decoder_model.predict(\n",
    "                [terget_seq, enc_out, h, c],\n",
    "                verbose=0\n",
    "            )\n",
    "            probs = output[0, -1]\n",
    "            top_indices = np.argsort(probs)[-beam_width:]\n",
    "\n",
    "            for tok in top_indices:\n",
    "                new_tokens = tokens + [tok]\n",
    "                new_score = score - np.log(probs[tok] + 1e-10)\n",
    "                new_beams.append((new_tokens, new_score, h, c))\n",
    "\n",
    "        beams = sorted(new_beams, key=lambda x: x[1])[:beam_width]\n",
    "\n",
    "    best_tokens = beams[0][0]\n",
    "\n",
    "    words = [\n",
    "        ger_tokenizer.index_word.get(t, '')\n",
    "        for t in best_tokens\n",
    "        if t != ger_tokenizer.word_index['start'] and t != ger_tokenizer.word_index['end']\n",
    "\n",
    "    ]\n",
    "\n",
    "\n",
    "    return ' '.join(words)\n"
   ]
  },
