   "source": [
    "print(data.info())\n",
    "english=data[0]\n",
    "frans=data[1]\n",
    "\n",
    "print(english.head())\n",
    "print(frans.head())\n",
    "def clean_text(text):\n",
    "    return text.strip()\n",
    "english=english.apply(clean_text)\n",
    "frans=frans.apply(clean_text)\n",
    "print(english.head())\n",
    "frans=frans.apply(lambda x: \"<start> \"+x+\" <end>\")\n",
    "print(frans.head())\n",
    "dec_input=frans.apply(lambda x: \" \".join(x.split()[0:-1]))\n",
    "dec_target=frans.apply(lambda x: \" \".join(x.split()[1:]))\n",
    "print(dec_input.head())\n",
    "print(dec_target.head())\n",
    "\n",
    "eng_tokenizer=Tokenizer()\n",
    "ger_tokenizer=Tokenizer()\n",
    "eng_tokenizer.fit_on_texts(english)\n",
    "ger_tokenizer.fit_on_texts(dec_input)\n",
    "ger_tokenizer.fit_on_texts(dec_target)\n",
    "\n",
    "english_seq = eng_tokenizer.texts_to_sequences(english)\n",
    "dec_in_seq = ger_tokenizer.texts_to_sequences(dec_input)\n",
    "dec_out_seq = ger_tokenizer.texts_to_sequences(dec_target)\n",
    "\n",
    "max_len_eng = max(len(s) for s in english_seq)\n",
    "max_len_dec_in = max(len(s) for s in dec_in_seq)\n",
    "max_len_dec_out = max(len(s) for s in dec_out_seq)\n",
    "\n",
    "\n",
    "pad_seque_eng = pad_sequences(english_seq,max_len_eng ,padding='post',truncating='post')\n",
    "dec_input_padded = pad_sequences(dec_in_seq, max_len_dec_in, padding='post')\n",
    "dec_target_padded = pad_sequences(dec_out_seq, max_len_dec_out, padding='post')\n",
    "enc_input = pad_seque_eng\n",
    "print(pad_seque_eng.shape)\n",
    "print(dec_input_padded.shape)\n",
    "print(dec_target_padded.shape)"
   ]
