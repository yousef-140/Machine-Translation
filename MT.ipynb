    "def translate_beam(sentence, beam_width=3, max_len=50):\n",
    "    # tokenize input\n",
    "    inp = eng_tokenizer.texts_to_sequences([sentence])\n",
    "    inp = pad_sequences(inp, max_len_eng, padding='post')\n",
    "    inp = tf.convert_to_tensor(inp)\n",
    "\n",
    "    start_token = ger_tokenizer.word_index[\"start\"]\n",
    "    end_token = ger_tokenizer.word_index[\"end\"]\n",
    "\n",
    "    beams = [([start_token], 0.0)]  # (tokens, log_prob)\n",
    "\n",
    "    for _ in range(max_len):\n",
    "        new_beams = []\n",
    "\n",
    "        for seq, score in beams:\n",
    "            if seq[-1] == end_token:\n",
    "                new_beams.append((seq, score))\n",
    "                continue\n",
    "\n",
    "            dec_input = tf.expand_dims(seq, 0)\n",
    "\n",
    "            preds = model([inp, dec_input], training=False)\n",
    "            probs = tf.nn.log_softmax(preds[:, -1, :])\n",
    "\n",
    "            top_k = tf.math.top_k(probs, k=beam_width)\n",
    "\n",
    "            for i in range(beam_width):\n",
    "                token = int(top_k.indices[0][i])\n",
    "                token_score = float(top_k.values[0][i])\n",
    "                new_beams.append((seq + [token], score + token_score))\n",
    "\n",
    "        beams = sorted(new_beams, key=lambda x: x[1], reverse=True)[:beam_width]\n",
    "\n",
    "    best_seq = beams[0][0]\n",
    "\n",
    "    words = [\n",
    "        ger_index_word.get(tok, \"\")\n",
    "        for tok in best_seq\n",
    "        if tok not in [start_token, end_token]\n",
    "    ]\n",
    "\n",
    "    return \" \".join(words)\n"
   ]
  },
