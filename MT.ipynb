    "#evaluation with BLEU\n",
    "import nltk\n",
    "from nltk.translate.bleu_score import corpus_bleu, SmoothingFunction\n",
    "\n",
    "smooth = SmoothingFunction().method1\n",
    "\n",
    "def compute_bleu(model, enc_inputs, dec_targets, tokenizer, max_samples=1000):\n",
    "    references = []\n",
    "    hypotheses = []\n",
    "    for i in range(min(len(enc_inputs), max_samples)):\n",
    "        true_sentencetes = dec_targets[i]\n",
    "        true_tokens = [tokenizer.index_word[idx]\n",
    "                       for idx in true_sentencetes if idx != 0\n",
    "                       ]\n",
    "        predicted_sentences = translate_beam(enc_inputs[i], beam_width=1)\n",
    "        predicted_tokens = predicted_sentences.split()\n",
    "\n",
    "        references.append([true_tokens])\n",
    "        hypotheses.append(predicted_tokens)\n",
    "\n",
    "    bleu_score = corpus_bleu(\n",
    "        references,\n",
    "        hypotheses,\n",
    "        smoothing_function=smooth\n",
    "    )\n",
    "    return bleu_score\n",
    "\n",
    "          \n",
    "\n"
   ]
