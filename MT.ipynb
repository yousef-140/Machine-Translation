   "source": [
    "from tensorflow.keras.layers import  LayerNormalization,Input\n",
    "\n",
    "transformer = Transformer(\n",
    "    num_layers=2,\n",
    "    d_model=128,\n",
    "    num_heads=8,\n",
    "    ff_dim=512,\n",
    "    input_vocab_size=len(eng_tokenizer.word_index) + 1,\n",
    "    target_vocab_size=len(ger_tokenizer.word_index) + 1,\n",
    "    max_pos_enc_in=max_len_eng,\n",
    "    max_pos_enc_out=max_len_dec_in\n",
    ")\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "id": "VqPa6Uwpu81m"
   },
   "outputs": [],
   "source": [
    "#training step\n",
    "@tf.function\n",
    "def train_step(inp, dec_inp, dec_target):\n",
    "    with tf.GradientTape() as tape:\n",
    "        predictions = transformer([inp, dec_inp], training=True)\n",
    "        loss = loss_function(dec_target, predictions)\n",
    "\n",
    "    gradients = tape.gradient(loss, transformer.trainable_variables)\n",
    "    optimizer.apply_gradients(\n",
    "        zip(gradients, transformer.trainable_variables)\n",
    "    )\n",
    "\n",
    "    return loss\n",
    "@tf.function\n",
    "def val_step(inp, dec_inp, dec_target):\n",
    "    predictions = transformer([inp, dec_inp], training=False)\n",
    "    loss = loss_function(dec_target, predictions)\n",
    "    return loss\n",
    "\n",
    "\n",
    "def training_loop(train_dataset, val_dataset, epochs):\n",
    "    for epoch in range(epochs):\n",
    "        print(f\"\\nEpoch {epoch+1}/{epochs}\")\n",
    "\n",
    "        train_loss = 0.0\n",
    "        train_batches = 0\n",
    "\n",
    "        for inp, dec_inp, dec_target in train_dataset:\n",
    "            loss = train_step(inp, dec_inp, dec_target)\n",
    "            train_loss += loss\n",
    "            train_batches += 1\n",
    "\n",
    "        train_loss /= train_batches\n",
    "\n",
    "        val_loss = 0.0\n",
    "        val_batches = 0\n",
    "\n",
    "        for inp, dec_inp, dec_target in val_dataset:\n",
    "            loss = val_step(inp, dec_inp, dec_target)\n",
    "            val_loss += loss\n",
    "            val_batches += 1\n",
    "\n",
    "        val_loss /= val_batches\n",
    "\n",
    "        print(f\"Train Loss: {train_loss:.4f}\")\n",
    "        print(f\"Val   Loss: {val_loss:.4f}\")\n",
    "\n",
    "\n",
    "\n"
   ]
  },
