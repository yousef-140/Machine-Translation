    "class Transformer(tf.keras.Model):\n",
    "    def __init__(\n",
    "        self,\n",
    "        num_layers,\n",
    "        d_model,\n",
    "        num_heads,\n",
    "        ff_dim,\n",
    "        input_vocab_size,\n",
    "        target_vocab_size,\n",
    "        max_pos_enc_in,\n",
    "        max_pos_enc_out,\n",
    "        rate=0.1,\n",
    "        **kwargs\n",
    "    ):\n",
    "        super().__init__(**kwargs)\n",
    "\n",
    "       ,
    "        self.num_layers = num_layers\n",
    "        self.d_model = d_model\n",
    "        self.num_heads = num_heads\n",
    "        self.ff_dim = ff_dim\n",
    "        self.input_vocab_size = input_vocab_size\n",
    "        self.target_vocab_size = target_vocab_size\n",
    "        self.max_pos_enc_in = max_pos_enc_in\n",
    "        self.max_pos_enc_out = max_pos_enc_out\n",
    "        self.rate = rate\n",
    "\n",
    "        self.encoder = build_transformer_encoder(\n",
    "            num_layers=num_layers,\n",
    "            d_model=d_model,\n",
    "            num_heads=num_heads,\n",
    "            ff_dim=ff_dim,\n",
    "            input_vocab_size=input_vocab_size,\n",
    "            maximum_position_encoding=max_pos_enc_in,\n",
    "            rate=rate\n",
    "        )\n",
    "\n",
    "        self.decoder = Decoder(\n",
    "            num_layers=num_layers,\n",
    "            d_model=d_model,\n",
    "            num_heads=num_heads,\n",
    "            ff_dim=ff_dim,\n",
    "            target_vocab_size=target_vocab_size,\n",
    "            maximum_position_encoding=max_pos_enc_out,\n",
    "            rate=rate\n",
    "        )\n",
    "\n",
    "        self.final_layer = Dense(target_vocab_size)\n",
    "\n",
    "\n",
    "    def call(self, inputs, training=False):\n",
    "        enc_inp, dec_inp = inputs\n",
    "\n",
    "        # Masks\n",
    "        enc_padding_mask = create_padding_mask(enc_inp)\n",
    "        look_ahead_mask = create_decoder_mask(dec_inp)\n",
    "\n",
    "        # Encoder\n",
    "        enc_output = self.encoder(enc_inp, training=training)\n",
    "\n",
    "        # Decoder\n",
    "        dec_output = self.decoder(\n",
    "            dec_inp,\n",
    "            enc_output,\n",
    "            training=training,\n",
    "            look_ahead_mask=look_ahead_mask,\n",
    "            padding_mask=enc_padding_mask\n",
    "        )\n",
    "\n",
    "        # Final logits\n",
    "        return self.final_layer(dec_output)\n",
    "\n",
    "#THIS FIXES load_model\n",
    "    def get_config(self):\n",
    "        config = super().get_config()\n",
    "        config.update({\n",
    "            \"num_layers\": self.num_layers,\n",
    "            \"d_model\": self.d_model,\n",
    "            \"num_heads\": self.num_heads,\n",
    "            \"ff_dim\": self.ff_dim,\n",
    "            \"input_vocab_size\": self.input_vocab_size,\n",
    "            \"target_vocab_size\": self.target_vocab_size,\n",
    "            \"max_pos_enc_in\": self.max_pos_enc_in,\n",
    "            \"max_pos_enc_out\": self.max_pos_enc_out,\n",
    "            \"rate\": self.rate,\n",
    "        })\n",
    "        return config\n",
    "\n",
    "    @classmethod\n",
    "    def from_config(cls, config):\n",
    "        return cls(**config)\n"
   ]
